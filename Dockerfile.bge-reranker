FROM ghcr.io/pvliesdonk/markdown-vault-mcp:latest

USER root

# uv manages the venv — use it for installs.
ENV VENV=/app/.venv
ENV PY=${VENV}/bin/python3

# 1. Update fork deps (fastmcp_pvl_core etc) in the venv.
COPY . /app/fork/
RUN uv pip install --python ${PY} "/app/fork/[mcp,embeddings]"

# 2. Install reranker deps (CPU-only torch).
RUN uv pip install --python ${PY} torch \
        --index-url https://download.pytorch.org/whl/cpu && \
    uv pip install --python ${PY} "sentence-transformers>=3.0"

# 3. Overwrite /app/src with fork source.
RUN cp -r /app/fork/src/markdown_vault_mcp/. /app/src/markdown_vault_mcp/

USER appuser
