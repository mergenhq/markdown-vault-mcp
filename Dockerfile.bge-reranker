FROM ghcr.io/pvliesdonk/markdown-vault-mcp:latest

USER root

# Install CPU-only torch first (avoid CUDA bloat), then sentence-transformers
RUN pip install --no-cache-dir torch \
        --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir "sentence-transformers>=3.0"

# Copy full source (v1.9.0 base + v1.28.0 fork = version mismatch on selective copy).
# Full src/ copy ensures type consistency (BacklinkInfo etc).
COPY src/markdown_vault_mcp/ /app/src/markdown_vault_mcp/

USER appuser
