FROM ghcr.io/pvliesdonk/markdown-vault-mcp:latest

USER root

# CLI uses /app/.venv — install everything into venv explicitly.
# 1. Update fork deps (fastmcp_pvl_core etc) inside the venv.
COPY . /app/fork/
RUN /app/.venv/bin/pip install --no-cache-dir "/app/fork/[mcp,embeddings]"

# 2. Install reranker deps into venv (CPU-only torch to keep image lean).
RUN /app/.venv/bin/pip install --no-cache-dir torch \
        --index-url https://download.pytorch.org/whl/cpu && \
    /app/.venv/bin/pip install --no-cache-dir "sentence-transformers>=3.0"

# 3. Overwrite /app/src with fork source (sys.path priority: /app/src before site-packages).
RUN cp -r /app/fork/src/markdown_vault_mcp/. /app/src/markdown_vault_mcp/

USER appuser
